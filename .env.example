# 설정 이름의 예시일 뿐 실제 키가 아니다. 실제 키는 로컬 .env 또는 Render Environment에 둔다.
# llm.settings()는 시스템 환경변수를 .env보다 우선하며, aaa는 미설정으로 처리한다.
OPENAI_API_KEY=aaa
# 답변 생성에 사용할 모델 이름. 프론트에는 모델명만 전달하고 키 값은 전달하지 않는다.
OPENAI_MODEL=gpt-4.1-mini
# API 선택 목록. 생략하면 기존 기본 모델과 아래 모델들을 허용한다.
# OPENAI_ALLOWED_MODELS=gpt-4.1-mini,gpt-5.4-mini,gpt-5.4,gpt-6-luna,gpt-6-sol,gpt-6.1-sol,gpt-6-astra
# 한국 종목 공시 재무제표. 로컬 .env / Render Environment에 발급받은 키를 설정한다.
DART_API_KEY=aaa
# 버핏지수 분기 대체 지표: FRED 공식 API. 실제 키는 .env / Render Environment에 설정한다.
FRED_API_KEY=aaa
# CNN 미국 주식 공포·탐욕 지수 중계. 실제 키는 .env에만 저장한다.
OANOR_API_KEY=FDFFD
